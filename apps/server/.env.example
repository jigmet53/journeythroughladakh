# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (local dev via `docker compose up -d` at the repo root)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/journey_through_ladakh?schema=public

# JWT — SECURITY CRITICAL, use long random strings, never reuse across envs
# Access token: short-lived (15 min), returned in the response body only
JWT_ACCESS_SECRET=change-me-access-secret
# Refresh token: long-lived (7 days), stored in an httpOnly cookie + DB-tracked
JWT_REFRESH_SECRET=change-me-refresh-secret

# Redis (local dev via `docker compose up -d` at the repo root)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — comma-separated allowlist, no wildcard origin echoing
CLIENT_URL=http://localhost:5173

# AI (M5 — AIModule / RAGModule)
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
