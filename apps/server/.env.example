# Server Configuration
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://journeythroughladakh_db_user:Jacklucy1341@journeythroughladakh.qmdtxhj.mongodb.net/

# JWT Configuration - SECURITY CRITICAL
# Access Token: Short-lived (15 minutes) - stored in memory on client
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production-use-strong-random-string

# Refresh Token: Long-lived (7 days) - stored in HTTP-only cookie
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-use-different-strong-random-string

# Redis Configuration - OPTIONAL (graceful degradation if not available)
# For production-grade caching, rate limiting, and session management
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Leave REDIS_PASSWORD empty if no password is set locally

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
